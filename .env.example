# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public app origin used for provider callbacks (HTTPS in production).
APP_URL="MY_APP_URL"

# Server & Runtime Configuration
NODE_ENV="development"
PORT=3000

# MongoDB Atlas Database Connectivity
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/marketly_production?retryWrites=true&w=majority"

# Cloudinary Media Architecture
CLOUDINARY_CLOUD_NAME="marketly-luxury"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Authentication & Session Secrets
AUTH_SECRET="replace_with_a_private_random_secret_at_least_32_characters"
SESSION_SECRET="secure_random_session_secret"

# Third-Party Social OAuth
# Set APP_URL to the application origin, then register these exact callback URLs:
#   ${APP_URL}/auth/callback/google
#   ${APP_URL}/auth/callback/facebook
# Keep provider secrets server-side; do not use VITE_ or other client-prefixed names.
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
FACEBOOK_APP_ID="your_facebook_app_id"
FACEBOOK_APP_SECRET="your_facebook_app_secret"

# Admin Bootstrap Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Account verification and password-reset email delivery are intentionally disabled.
# If an administrator needs to recover access, use the support/admin workflow instead.

BKASH_SANDBOX=true
BKASH_APP_KEY="bkash_app_key"
BKASH_APP_SECRET="bkash_app_secret"
BKASH_USERNAME="bkash_merchant_username"
BKASH_PASSWORD="bkash_merchant_password"
# Nagad and debit/credit card checkout are disabled until a verified merchant integration is added.
